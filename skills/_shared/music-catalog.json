  "noGeneration": {
    "engine": "none"
  },
  "adapters": [
    {
      "tool": "music_generate_clip",
      "engine": "lyria",
      "purpose": "Generate a fixed 30-second Google Lyria clip from a single prompt.",
      "fixedModel": "lyria-3-clip-preview",
      "fields": [
        "prompt",
        "outputPath",
        "filename"
      ]
    },
    {
      "tool": "music_generate_song",
      "engine": "lyria",
      "purpose": "Generate an instrumental or vocal track with Google Lyria Clip or 3.5, with optional lyrics.",
      "fields": [
        "model",
        "prompt",
        "lyrics",
        "instrumental",
        "outputPath",
        "filename"
      ]
    },
    {
      "tool": "music_generate",
      "engine": "lyria",
      "purpose": "Generate a Google Lyria RealTime instrumental from one prompt for a requested duration.",
      "fixedModel": "models/lyria-realtime-exp",
      "fields": [
        "prompt",
        "genre",
        "mood",
        "instruments",
        "durationSeconds",
        "bpm",
        "outputPath",
        "filename"
      ]
    },
    {
      "tool": "music_generate_advanced",
      "engine": "lyria",
      "purpose": "Blend weighted prompts and adjust musical controls for a Google Lyria RealTime instrumental.",
      "fixedModel": "models/lyria-realtime-exp",
      "fields": [
        "prompts",
        "durationSeconds",
        "config",
        "outputPath",
        "filename"
      ]
    },
    {
      "tool": "suno_generate",
      "engine": "suno-api",
      "purpose": "Generate two song variants through the third-party sunoapi.org V6 API.",
      "fields": [
        "prompt",
        "lyrics",
        "customMode",
        "instrumental",
        "style",
        "title",
        "model",
        "duration",
        "negativeTags",
        "vocalGender",
        "styleWeight",
        "weirdnessConstraint",
        "audioWeight",
        "variety",
        "personaId",
        "personaModel",
        "pickTrack",
        "outputPath",
        "filename"
      ]
    },
    {
      "tool": "suno_generate_sound",
      "engine": "suno-api",
      "purpose": "Disabled. The sunoapi.org sounds API has no documented way to retrieve the finished audio.",
      "fields": [
        "prompt",
        "model",
        "soundLoop",
        "soundTempo",
        "soundKey",
        "pickTrack",
        "outputPath",
        "filename"
      ]
    },
    {
      "tool": "music_elevenlabs_generate",
      "engine": "elevenlabs",
      "purpose": "Generate an ElevenLabs music track from a prompt or a section-by-section composition plan.",
      "fields": [
        "modelId",
        "prompt",
        "compositionPlan",
        "musicLengthMs",
        "forceInstrumental",
        "seed",
        "storeForInpainting",
        "outputPath",
        "filename"
      ]
    },
    {
      "tool": "music_stable_audio_generate",
      "engine": "stable-audio-mlx",
      "purpose": "Generate music with Stable Audio 3 Medium on Apple Silicon, optionally varying or inpainting a source recording.",
      "fields": [
        "model",
        "prompt",
        "durationSeconds",
        "steps",
        "seed",
        "cfg",
        "negativePrompt",
        "apg",
        "initAudioPath",
        "initNoiseLevel",
        "inpaintRange",
        "outputPath",
        "filename"
      ]
    },
    {
      "tool": "mlx_music_generate",
      "engine": "mlx",
      "purpose": "Generate music locally with the selected MLX Core music pack.",
      "fields": [
        "prompt",
        "model",
        "lyrics",
        "instrumental",
        "durationSeconds",
        "seed",
        "steps",
        "bpm",
        "keyscale",
        "refAudioPath",
        "outputPath",
        "filename"
      ]
    }
  ],
  "local": {
    "engine": "mlx",
    "tool": "mlx_music_generate",
    "model": "Exact installed MLX Core music pack ID; no automatic pack selection"
  },
  "unimplemented": [
    {
      "engine": "suno-official",
      "reason": "Official platform exists; authenticated request schema not verified",
      "source": "https://platform.suno.com/"
    },
    {
      "engine": "lyria-vertex",
      "reason": "Separate Cloud authentication and predict contract; not a Gemini adapter"
    }
  ],
  "sources": [
    "https://aistudio.google.com/docs/music-generation",
    "https://aistudio.google.com/docs/realtime-music-generation",
    "https://elevenlabs.io/docs/api-reference/music/compose",
    "https://docs.sunoapi.org/suno-api/generate-music",
    "https://github.com/ddalcu/mlx-serve/blob/v26.11.3/src/plugins/music3/plugin.zig",
