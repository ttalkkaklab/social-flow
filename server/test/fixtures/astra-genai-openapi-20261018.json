ationError":{"properties":{"detail":{"items":{"$ref":"#/components/schemas/ValidationError"},"type":"array","title":"Detail"}},"type":"object","title":"HTTPValidationError"},"Heartbeat":{"properties":{"lease_id":{"type":"string","maxLength":64,"minLength":1,"title":"Lease Id"}},"additionalProperties":false,"type":"object","required":["lease_id"],"title":"Heartbeat","description":"Identify a specific leased attempt."},"ImageVideo":{"properties":{"prompt":{"type":"string","maxLength":5000,"minLength":1,"title":"Prompt"},"model":{"type":"string","title":"Model"},"duration":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Duration"},"resolution":{"type":"string","title":"Resolution"},"fps":{"type":"integer","enum":[24,25,48,50],"title":"Fps","default":24},"generate_audio":{"type":"boolean","title":"Generate Audio","default":true},"camera_motion":{"anyOf":[{"type":"string","enum":["dolly_in","dolly_out","dolly_left","dolly_right","jib_up","jib_down","static","focus_shift"]},{"type":"null"}],"title":"Camera Motion"},"image_uri":{"type":"string","title":"Image Uri"},"last_frame_uri":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Last Frame Uri"}},"additionalProperties":false,"type":"object","required":["prompt","model","duration","resolution","image_uri"],"title":"ImageVideo","description":"Add the provider's image URI fields."},"Input":{"properties":{"messages":{"items":{"$ref":"#/components/schemas/Message"},"type":"array","maxItems":1,"minItems":1,"title":"Messages"}},"additionalProperties":false,"type":"object","required":["messages"],"title":"Input"},"Lease":{"properties":{"model":{"type":"string","title":"Model"},"wait_seconds":{"type":"integer","maximum":25.0,"minimum":0.0,"title":"Wait Seconds","default":25}},"additionalProperties":false,"type":"object","required":["model"],"title":"Lease","description":"Request only the deployed image model."},"Message":{"properties":{"role":{"type":"string","const":"user","title":"Role"},"content":{"items":{"$ref":"#