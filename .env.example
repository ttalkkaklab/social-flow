# social-flow — environment variables
#
# Copy to a file your shell sources (or export these directly). `.mcp.json` passes
# them through from the environment to the MCP server; nothing is read from a
# committed file. `.env` itself is gitignored — never commit real keys.
#
#   cp .env.example .env && $EDITOR .env && set -a && . ./.env && set +a
#
# Every variable is optional. Unset ones simply disable the tools that need them,
# with an explicit error if you call one anyway. See README.md § "API keys — what
# each one unlocks" and docs/guides/costs-and-keys/ for the full walkthrough.
#
# BILLING: every key below is a metered vendor account — you pay for what you call.
# The on-device engines are the free lane: image_local_generate (mflux/Z-Image),
# tts_local_generate (Supertonic), and whisper.cpp for transcription all run on your
# machine at zero cost. A run with no keys at all still produces a video; what you
# lose is text-bearing frames (covers), generated video, and BGM.
# Default spend on a paid episode is ~$0.26–0.29 against a $0.30 cap the pipeline
# checks before spending. Prices: skills/autoproduce/references/prices.tsv.


# ── Production keys — these make the video (metered) ──────────────────────────

# OpenAI (platform.openai.com/api-keys)
# Cover frames and any frame with text on it. On-device image generation garbles
# Korean glyphs, so text-bearing frames go to GPT Image. Scene backgrounds default
# to the on-device engine and need no key.
OPENAI_API_KEY=

# Google Gemini (aistudio.google.com/apikey)
# Veo 3.1 video, acted TTS narration, and Lyria BGM. Plain narration defaults to
# the on-device engine and needs no key. GOOGLE_API_KEY works as an alias.
GEMINI_API_KEY=

# BytePlus ModelArk (ai.byteplus.com/ark) — the second video engine, Seedance.
# 2–30s clips billed per second, cheaper for silent cuts. Veo works without this.
# Dreamina Seedance 2.x models additionally need an account balance over $30 or a
# resource pack; 1.5 pro and 1.0 have no such gate.
ARK_API_KEY=
# Region endpoint. The video models only exist in ap-southeast-1, so leave this alone
# unless you know you need a different region.
# ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# Python interpreter for on-device TTS (Supertonic). Point it at your virtualenv if
# you installed `supertonic` there — there is no venv auto-discovery on purpose.
# SUPERTONIC_PYTHON=~/venvs/tts/bin/python


# ── Research keys — optional; storyboard falls back to WebSearch ──────────────

# SerpApi (serpapi.com) — 250 free searches/month. Also required by sns_issue_scout.
SERPAPI_API_KEY=

# Naver Open API (developers.naver.com) — 25,000 calls/day free, first choice for
# Korean-language research.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Korea open-data portal (data.go.kr). Search, detail, and file download work with
# no key at all; only datago_file_fetch and datago_api_call need this — and each
# individual API also needs its own usage application on the portal.
DATA_GO_KR_API_KEY=

# YouTube Data API key for youtube_topic_scout. Without it the scout falls back to
# channel OAuth (youtube.readonly).
YOUTUBE_API_KEY=


# ── Platform credentials — optional; they unlock publishing and growth loops ──
#
# Tokens live in files under SNS_TOKEN_DIR, not in variables. Configure them and
# `publish` posts to your accounts and the grow-* skills operate the channel on a
# loop; skip them and everything through production still works — you get the
# finished video plus per-platform text in output/ and upload by hand.
#
# Per-channel layout (multi-channel):  <SNS_TOKEN_DIR>/<channel-slug>/threads_token
# Flat layout (single channel):        <SNS_TOKEN_DIR>/threads_token
# File names: threads_token · instagram_token · facebook_page_token ·
#             youtube-oauth-client.json   (chmod 600, never committed)
#
# The setup-threads / setup-instagram / setup-youtube skills issue these for you;
# skills/publish/references/token-setup.md documents the manual route.

# SNS_TOKEN_DIR=~/.config/social-flow

# Individual overrides of the flat paths (not applied to channel directories).
# THREADS_TOKEN_FILE=
# INSTAGRAM_TOKEN_FILE=
# FACEBOOK_PAGE_TOKEN_FILE=
# YOUTUBE_OAUTH_FILE=


# ── Media hosting — only for grow-threads image posts ─────────────────────────
#
# Threads accepts images as public URLs only, so local files need somewhere to live.
# Any endpoint works that takes POST with an `x-api-key` header plus raw bytes,
# returns 201 {data:{url}}, and serves that url as an unauthenticated public GET.
# The contract is documented at the top of
# skills/grow-threads/references/upload-media.sh.
# Unset, only the image step turns off — text posts still go out.

MEDIA_UPLOAD_URL=
MEDIA_UPLOAD_API_KEY=
