<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>ShootConsole</string>
	<key>CFBundleDisplayName</key>
	<string>ShootConsole</string>
	<key>CFBundleIdentifier</key>
	<string>app.socialflow.shootconsole</string>
	<key>CFBundleExecutable</key>
	<string>ShootConsole</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- screencapture -g takes the microphone under this app's responsibility.
	     Without this key the process just dies instead of asking for the
	     permission. Screen recording has no matching key — the system asks on
	     its own. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Records your narration along with the screen while you read the script.</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>Used to check and set the microphone input volume.</string>
</dict>
</plist>
