# ── OS ────────────────────────────────────────────────────────────
.DS_Store
._*
Thumbs.db

# ── 에디터 ────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*~

# ── Node ──────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
*.log
# server/dist/ 는 무시하지 않는다 — .mcp.json 이 빌드 단계 없이
# ${CLAUDE_PLUGIN_ROOT}/server/dist/index.js 를 직접 실행하므로 커밋 대상이다.

# ── Python (skills/**/references/*.py) ────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ── 로컬 세션 설정 ────────────────────────────────────────────────
.claude/settings.local.json
.claude/*.local.md

# ── 시크릿·자격증명 (절대 커밋 금지) ──────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
client_secret*.json
token.json
tokens.json
*-token.json

# ── git 워크트리 (스프린트 작업 공간) ─────────────────────────────
.worktrees/

# ── 콘텐츠 데이터 ─────────────────────────────────────────────────
# 채널 작업물(profile.md·스토리보드·이미지·영상·브랜딩 자산)은 로컬 산출물이다.
# 이 저장소는 플러그인 코드·스킬만 담는다. 구조 설명 문서만 예외로 커밋한다.
data/*
!data/README.md

# 작업 중간 산출물 (data/ 밖에서 생겨도 무시)
.work/
