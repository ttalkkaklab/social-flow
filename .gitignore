# ── OS ────────────────────────────────────────────────────────────
.DS_Store
._*
Thumbs.db

# ── Editors ───────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*~

# ── Node ──────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
*.log
# server/dist/ is NOT ignored — .mcp.json runs
# ${CLAUDE_PLUGIN_ROOT}/server/dist/index.js directly with no build step, so it's committed.

# ── Python (skills/**/references/*.py) ────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ── Local session settings ────────────────────────────────────────
.claude/settings.local.json
.claude/*.local.md
CLAUDE.local.md

# ── Secrets·credentials (never commit) ────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
client_secret*.json
token.json
tokens.json
*-token.json

# ── git worktrees (sprint workspaces) ─────────────────────────────
.worktrees/

# ── Content data ──────────────────────────────────────────────────
# Channel work products (profile.md·storyboards·images·videos·branding assets) are local artifacts.
# This repo holds only plugin code and skills. The structure doc is the one committed exception.
data/*
!data/README.md

# Work intermediates (ignored even when created outside data/)
.work/
**/assets/scratch/

# ── Swift app (apps/shoot-console) ────────────────────────────────
# Build artifacts aren't committed — unlike server/dist they're not on the
# plugin's execution path, and users build and sign them with build-app.sh
# themselves (the signing identity differs per machine).
apps/*/.build/
apps/*/build/
